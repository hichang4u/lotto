{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "allowJs": true,
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["src/**/*"]
}
